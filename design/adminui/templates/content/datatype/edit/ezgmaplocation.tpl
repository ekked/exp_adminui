{* DO NOT EDIT THIS FILE! Use an override template instead. *}
{if is_set( $attribute_base )|not}
  {def $attribute_base = 'ContentObjectAttribute'}
{/if}
{* Make sure to normalize floats from db  *}
{def $latitude  = $attribute.content.latitude|explode(',')|implode('.')
     $longitude = $attribute.content.longitude|explode(',')|implode('.')}
<div class="row">

    <div class="col-sm-8">
        {run-once}
        {* The Google Maps API only with an API key: Google draws no map and finds no address without one, and the page
           would load a script from another host for nothing (which a Content Security Policy then has to allow).
           Without a key the latitude and longitude are entered by hand (exp_adminui_gmaplocation.js leaves the map alone). *}
        {if and( ezini_hasvariable( 'GMapSettings', 'ApiKey', 'ezgmaplocation.ini' ), ezini( 'GMapSettings', 'ApiKey', 'ezgmaplocation.ini' )|trim|ne( '' ) )}
            <script type="text/javascript" src="https://maps.googleapis.com/maps/api/js?key={ezini( 'GMapSettings', 'ApiKey', 'ezgmaplocation.ini' )|trim|urlencode}"></script>
        {/if}
        {ezscript( array( 'exp_adminui_gmaplocation.js' ) )}
        {/run-once}

        {* the map is set up on window load from the data-expui-gml* attributes of its element (exp_adminui_gmaplocation.js) *}
        <div class="input-group form-group">
            <input type="text" class="form-control" id="ezgml-address-{$attribute.id}" name="{$attribute_base}_data_gmaplocation_address_{$attribute.id}" value="{$attribute.content.address|html_entity_decode|wash}"/>
            <div class="input-group-btn">
                <button class="btn btn-default" type="button" id="ezgml-address-button-{$attribute.id}"><i class="fa fa-search"></i> {'Find address'|i18n('extension/ezgmaplocation/datatype')}</button>
                <input class="btn btn-default" type="button" id="ezgml-restore-button-{$attribute.id}" value="{'Restore'|i18n('extension/ezgmaplocation/datatype')}" data-expui-prevent disabled="disabled"  title="{'Restores location and address values to what it was on page load.'|i18n('extension/ezgmaplocation/datatype')}" />
            </div>
        </div>

        <input id="ezgml_hidden_address_{$attribute.id}" type="hidden" name="ezgml_hidden_address_{$attribute.id}" value="{$attribute.content.address|html_entity_decode|wash}" disabled="disabled" />
        <input id="ezgml_hidden_latitude_{$attribute.id}" type="hidden" name="ezgml_hidden_latitude_{$attribute.id}" value="{$latitude}" disabled="disabled" />
        <input id="ezgml_hidden_longitude_{$attribute.id}" type="hidden" name="ezgml_hidden_longitude_{$attribute.id}" value="{$longitude}" disabled="disabled" />
    </div>
</div>
<div class="row">
    <div class="col-sm-8">
        <div id="ezgml-map-{$attribute.id}" class="aui-gmap" data-expui-gml="{$attribute.id}" data-expui-gml-base="{if ne( $attribute_base, 'ContentObjectAttribute' )}{$attribute_base|wash}-{/if}{$attribute.contentclassattribute_id}_{$attribute.contentclass_attribute_identifier|wash}" data-expui-gml-not-found="{'%address not found'|i18n( 'extension/ezgmaplocation/datatype' )|wash}" data-expui-gml-location-error="{'Could not get your location, error was: %error'|i18n( 'extension/ezgmaplocation/datatype' )|wash}"></div>
    </div>

    <div class="col-sm-4">
        <div class="block">
            <label>{'Latitude'|i18n('extension/ezgmaplocation/datatype')}:</label>
            <input id="ezcoa-{if ne( $attribute_base, 'ContentObjectAttribute' )}{$attribute_base}-{/if}{$attribute.contentclassattribute_id}_{$attribute.contentclass_attribute_identifier}_latitude" class="form-control ezcc-{$attribute.object.content_class.identifier} ezcca-{$attribute.object.content_class.identifier}_{$attribute.contentclass_attribute_identifier}" type="text" name="{$attribute_base}_data_gmaplocation_latitude_{$attribute.id}" value="{$latitude}" />
        </div>

        <div class="block">
            <label>{'Longitude'|i18n('extension/ezgmaplocation/datatype')}:</label>
            <input id="ezcoa-{if ne( $attribute_base, 'ContentObjectAttribute' )}{$attribute_base}-{/if}{$attribute.contentclassattribute_id}_{$attribute.contentclass_attribute_identifier}_longitude" class="form-control ezcc-{$attribute.object.content_class.identifier} ezcca-{$attribute.object.content_class.identifier}_{$attribute.contentclass_attribute_identifier}" type="text" name="{$attribute_base}_data_gmaplocation_longitude_{$attribute.id}" value="{$longitude}" />
        </div>

        <div class="block">
            <input class="btn btn-default" type="button" id="ezgml-mylocation-button-{$attribute.id}" value="{'My current location'|i18n('extension/ezgmaplocation/datatype')}" data-expui-prevent disabled="disabled" title="{'Gets your current position if your browser support GeoLocation and you grant this website access to it! Most accurate if you have a built in gps in your Internet device! Also note that you might still have to type in address manually!'|i18n('extension/ezgmaplocation/datatype')}" />
        </div>
    </div>


</div>
